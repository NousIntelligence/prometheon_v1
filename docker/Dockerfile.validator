# syntax=docker/dockerfile:1.7
#
# Prometheon Phase 1 validator image.
#
# Build context: repository root.
# Build:
#   docker build -f docker/Dockerfile.validator -t prometheon-validator:dev .
#
# A validator is TWO long-running processes sharing one event store:
#   1. `ingest serve`  — receives the platform's signed pushes (public HTTPS)
#   2. `validator run` — scores that store and submits weights
#
# Run them as two containers off this one image. `docker/compose.yaml` does
# exactly that, handles the UID and mount details below, and is the shortest
# path:
#
#   export PROMETHEON_UID=$(id -u) PROMETHEON_GID=$(id -g)
#   docker compose -f docker/compose.yaml up --build
#
# Running it by hand needs three things right, all of which fail hard if wrong:
#
#   --user $(id -u):$(id -g)   Your wallet keyfiles are mode 0600 owned by you,
#                              and a bind-mounted state directory is yours too.
#                              The image's own user (UID 10001) can read and
#                              write neither.
#   -e HOME=/home/prometheon   Your UID has no passwd entry in the image, so
#                              HOME is otherwise unset and the wallet is not
#                              found.
#   wallet mounted read-write  `import bittensor` unconditionally creates
#                              ~/.bittensor/{miners,wallets}; with `:ro` it dies
#                              at import with Errno 30. Signing never writes.
#
# The ingest half:
#   docker run --rm -it -p 127.0.0.1:8541:8541 \
#       --user $(id -u):$(id -g) \
#       -v ./prometheon-testnet.toml:/etc/prometheon/config.toml:ro \
#       -v ./validator-state:/var/lib/prometheon/state \
#       prometheon-validator:dev \
#       ingest serve --config /etc/prometheon/config.toml \
#                    --db /var/lib/prometheon/state/events.sqlite \
#                    --host 0.0.0.0 --port 8541
#
# and the weight half:
#   docker run --rm -it \
#       --user $(id -u):$(id -g) -e HOME=/home/prometheon \
#       -e PROMETHEON_VALIDATOR_API_TOKEN=<token> \
#       -v ~/.bittensor:/home/prometheon/.bittensor \
#       -v ./prometheon-testnet.toml:/etc/prometheon/config.toml:ro \
#       -v ./validator-state:/var/lib/prometheon/state \
#       prometheon-validator:dev
#
# `events_db` in your config MUST be the absolute path inside the container
# (/var/lib/prometheon/state/events.sqlite) so both halves open the same file.
# The default is relative and would resolve against each container's CWD.
#
# The image defines a non-root user (`prometheon`, UID 10001) so it never runs
# as root by default; override it with `--user` as above when you bind-mount
# host-owned files.

# --- Builder stage -----------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/prometheon/.venv

# System packages needed to build wheels (no extra binaries beyond what
# the runtime actually needs).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

# Install uv into a stable path.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /opt/prometheon

# Cache layer for dependencies: copy the lockfile + pyproject first.
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY neurons ./neurons
COPY configs ./configs

# Install runtime dependencies plus the package itself.
RUN uv sync --frozen --no-dev


# --- Runtime stage -----------------------------------------------------------
FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/prometheon/.venv/bin:${PATH}"

# Minimal runtime packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for the validator process.
RUN groupadd --system --gid 10001 prometheon \
    && useradd --system --uid 10001 --gid 10001 \
        --create-home --shell /usr/sbin/nologin prometheon

# Copy the prepared virtual environment and the source from the builder.
COPY --from=builder --chown=prometheon:prometheon /opt/prometheon /opt/prometheon

# Default mount points; the operator is expected to bind-mount these.
RUN mkdir -p /etc/prometheon /var/lib/prometheon/state \
    && chown -R prometheon:prometheon /etc/prometheon /var/lib/prometheon

USER prometheon
WORKDIR /opt/prometheon

# The ingest service listens here; front it with a TLS reverse proxy. The
# weight half ignores this — it opens the store read-only and talks only to
# the chain.
EXPOSE 8541

# tini reaps zombies and forwards signals cleanly.
ENTRYPOINT ["/usr/bin/tini", "--", "prometheon"]
CMD ["validator", "run", \
     "--config", "/etc/prometheon/config.toml", \
     "--state-directory", "/var/lib/prometheon/state"]
