# syntax=docker/dockerfile:1.7
#
# Prometheon Phase 1 miner image.
#
# Phase 1 miners do not run a continuous daemon — rewards depend on real
# BitFan Fan Group growth, which happens off-chain. The miner image ships
# the same CLI as the validator image so operators can invoke the
# identity flows (verify-miner, rotate-hotkey, recover-hotkey) and the
# informational status entrypoint from a single packaged binary.
#
# Build:
#   docker build -f docker/Dockerfile.miner -t prometheon-miner:dev .
#
# Run (status):
#   docker run --rm -it prometheon-miner:dev
#
# Run (verify-miner):
#   docker run --rm -it \
#       -e PROMETHEON_MINER_API_TOKEN=<token> \
#       -v ~/.bittensor:/home/prometheon/.bittensor:ro \
#       prometheon-miner:dev verify-miner --username <u> --email <e> ...
#
# The image runs as a non-root user (`prometheon`, UID 10001).

# --- Builder stage -----------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/prometheon/.venv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /opt/prometheon

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY neurons ./neurons
COPY configs ./configs
COPY scripts ./scripts
COPY docs ./docs
COPY LICENSE SECURITY.md CONTRIBUTING.md ./

RUN uv sync --frozen --no-dev


# --- Runtime stage -----------------------------------------------------------
FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/prometheon/.venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 prometheon \
    && useradd --system --uid 10001 --gid 10001 \
        --create-home --shell /usr/sbin/nologin prometheon

COPY --from=builder --chown=prometheon:prometheon /opt/prometheon /opt/prometheon

USER prometheon
WORKDIR /opt/prometheon

ENTRYPOINT ["/usr/bin/tini", "--", "python", "neurons/miner.py"]
